{
  "name": "@varosity/mcp-server",
  "version": "0.1.2",
  "mcpName": "io.github.jonkludt/varosity",
  "description": "MCP server for Varosity AI \u2014 stdio transport, proxies to varosity.ai/api/mcp",
  "license": "MIT",
  "homepage": "https://varosity.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/varosity-ai/mcp-server.git"
  },
  "type": "module",
  "bin": {
    "varosity-mcp": "bin/varosity-mcp.mjs"
  },
  "files": [
    "bin/**",
    "dist/**",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "node --watch src/index.ts",
    "prepare": "tsc"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "varosity",
    "mcp",
    "ai",
    "video",
    "voice",
    "music"
  ],
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  },
  "bugs": {
    "url": "https://github.com/varosity-ai/mcp-server/issues"
  }
}
